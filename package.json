{
  "name": "electron-lark",
  "version": "1.1.6",
  "main": "src/main.js",
  "description": "An Electron application for Feishu(Lark)",
  "author": "Ericwyn <ericwyn@meetwhy.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ericwyn/electron-lark.git"
  },
  "keywords": [
    "Electron",
    "Feishu",
    "Lark",
    "飞书"
  ],
  "bugs": "https://github.com/Ericwyn/electron-lark/issues",
  "homepage": "https://github.com/Ericwyn/electron-lark",
  "scripts": {
    "start": "electron .",
    "pack:mac": "install-electron && electron-builder --mac --arm64 --dir && codesign --force --deep --sign - 'dist/mac-arm64/Electron Lark.app'",
    "test": "electron test/upgrade.cjs"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "linux": {
    "category": "Office",
    "packageCategory": "Office",
    "synopsis": "An Electron application for Feishu(Lark)",
    "icon": "./build/icons",
    "target": [
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "desktop": {
      "Encoding": "UTF-8"
    }
  },
  "dependencies": {
    "electron-context-menu": "5.0.0"
  },
  "build": {
    "appId": "io.github.ericwyn.electron-lark",
    "productName": "Electron Lark",
    "asar": true,
    "files": [
      "src/**/*",
      "icon/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon/macos.icns",
      "identity": null,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "electronDist": "node_modules/electron/dist"
  }
}
